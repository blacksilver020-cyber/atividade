<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AppHotel"
       x:Class="AppHotel.AppShell"
       Title="App Hotel"
       FlyoutBehavior="Flyout">
    <FlyoutItem Title="Reservar" Route="reserva">
        <ShellContent Title="Reservar" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Sobre" Route="sobre">
        <ShellContent Title="Sobre" ContentTemplate="{DataTemplate local:AboutPage}" />
    </FlyoutItem>
</Shell>
