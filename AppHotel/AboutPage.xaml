<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.AboutPage"
             Title="Sobre"
             BackgroundColor="{StaticResource Soft}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 26" Padding="24">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="✦" FontSize="48" TextColor="{StaticResource Gold}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="APP HOTEL" FontSize="27" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="2"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Sobre o projeto" FontSize="15"
                           TextColor="#D8E8F2" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Informações do aplicativo" FontSize="19"
                           FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Desenvolvedor" FontSize="12" TextColor="#718596"/>
                        <Label Text="[Cauã Gabriel]" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#E8EEF2"/>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Ano de desenvolvimento" FontSize="12" TextColor="#718596"/>
                        <Label Text="2026" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#E8EEF2"/>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Disciplina" FontSize="12" TextColor="#718596"/>
                        <Label Text="Programação Mobile I" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#E8EEF2"/>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Tecnologia" FontSize="12" TextColor="#718596"/>
                        <Label Text=".NET MAUI • C# • XAML" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Aplicativo desenvolvido como atividade acadêmica, explorando componentes de interface gráfica e navegação entre telas."
                   FontSize="13" TextColor="#607486" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
